        // Render Hazard Pins
        function renderPins() {
            const container = document.getElementById('pins-container');
            container.innerHTML = '';

            pins.forEach(pin => {
                const el = document.createElement('div');
                const isSelected = activeSelectedPinId === pin.id;
                
                // Color matching based on severity
                let colorClass = 'bg-amber-500 text-white';
                let pulseClass = '';
                if (pin.severity === 'ต่ำ') colorClass = 'bg-emerald-500 text-white';
                if (pin.severity === 'ปานกลาง') colorClass = 'bg-amber-500 text-white';
                if (pin.severity === 'สูง') colorClass = 'bg-orange-500 text-white';
                if (pin.severity === 'วิกฤต') {
                    colorClass = 'bg-rose-600 text-white';
                    pulseClass = 'animate-pin-pulse';
                }

                el.className = `absolute transform -translate-x-1/2 -translate-y-full cursor-pointer pointer-events-auto transition-transform ${isSelected ? 'scale-125 z-20' : 'hover:scale-110 z-10'}`;
                el.style.left = `${pin.x}px`;
                el.style.top = `${pin.y}px`;

                el.innerHTML = `
                    <div class="relative group">
                        <!-- Pin Icon Badge -->
                        <div class="w-8 h-8 rounded-full ${colorClass} ${pulseClass} shadow-lg flex items-center justify-center border-2 border-white">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                        </div>
                        
                        <!-- Popover Tooltip on Hover -->
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block w-48 bg-slate-900 text-white text-[11px] rounded-lg p-2.5 shadow-xl z-30 pointer-events-none">
                            <div class="font-bold border-b border-slate-700 pb-1 mb-1 truncate">${pin.title}</div>
                            <div>ตำแหน่ง: <span class="text-slate-300">${pin.locationName}</span></div>
                            <div>ระดับความรุนแรง: <span class="font-semibold text-amber-300">${pin.severity}</span></div>
                            <div>สถานะ: ${pin.status}</div>
                        </div>
                    </div>
                `;

                el.addEventListener('click', (e) => {
                    e.stopPropagation();
                    highlightPin(pin.id);
                });

                container.appendChild(el);
            });

            lucide.createIcons();
        }

        // Detect Zone Name based on X, Y Coordinates for Default Laundry Plan
        function detectZoneName(x, y) {
            if (customPlanImage) return `พิกัด X:${x}, Y:${y}`;

            if (x >= 180 && x <= 300 && y >= 110 && y <= 180) return 'ห้องเก็บสารเคมี';
            if (x >= 180 && x <= 300 && y >= 180 && y <= 300) return 'ห้องเครื่องชั่งน้ำหนักผ้า';
            if (x >= 180 && x <= 300 && y >= 390 && y <= 510) return 'ห้องควบคุม';
            if (x >= 310 && x <= 640 && y >= 140 && y <= 200) return 'ห้องเครื่องซักผ้า';
            if (x >= 310 && x <= 640 && y >= 200 && y <= 290) return 'ห้องเครื่องอบผ้า';
            if (x >= 640 && x <= 950 && y >= 70 && y <= 200) return 'ห้องพับผ้า';
            if (x >= 640 && x <= 950 && y >= 200 && y <= 410) return 'บริเวณเครื่องรีดผ้าและเครื่องพับผ้า';
            if (x >= 645 && x <= 770 && y >= 410 && y <= 510) return 'ห้องสำนักงาน';
            if (x >= 770 && x <= 950 && y >= 410 && y <= 510) return 'ห้องบรรจุผ้า';

            return 'โถงทางเดิน / พื้นที่ทั่วไป';
        }

        // Canvas Click Handler (User Pin Creation)
        function handleCanvasClick(e) {
            if (isPanMode) return;

            const rect = document.getElementById('floor-plan-background').getBoundingClientRect();
            const x = Math.round((e.clientX - rect.left) / zoomScale);
            const y = Math.round((e.clientY - rect.top) / zoomScale);

            const locationName = detectZoneName(x, y);

            // Open Modal for New Hazard Report
            document.getElementById('report-x').value = x;
            document.getElementById('report-y').value = y;
            document.getElementById('report-location-name').value = locationName;
            document.getElementById('hazard-form').reset();
            document.getElementById('report-x').value = x;
            document.getElementById('report-y').value = y;
            document.getElementById('report-location-name').value = locationName;

            openModal('report-modal');
        }

        // Form Submit Handler
        function handleFormSubmit(e) {
            e.preventDefault();

            const newPin = {
                id: 'pin_' + Date.now(),
                title: document.getElementById('report-title').value,
                category: document.getElementById('report-category').value,
                severity: document.getElementById('report-severity').value,
                desc: document.getElementById('report-desc').value,
                author: document.getElementById('report-author').value,
                status: 'รอแก้ไข',
                x: parseInt(document.getElementById('report-x').value),
                y: parseInt(document.getElementById('report-y').value),
                locationName: document.getElementById('report-location-name').value,
                timestamp: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
            };

            pins.unshift(newPin);
            saveData();
            renderPins();
            renderTable();
            closeModal('report-modal');
            showToast('บันทึกการแจ้งจุดเสี่ยงเรียบร้อยแล้ว');
        }

        // Render Hazard Reports Table
        function renderTable() {
            const tbody = document.getElementById('table-body');
            const emptyState = document.getElementById('empty-state');
            const searchVal = document.getElementById('search-input').value.toLowerCase();
            const filterStatus = document.getElementById('filter-status').value;
            const filterSeverity = document.getElementById('filter-severity').value;

            const filteredPins = pins.filter(pin => {
                const matchSearch = pin.title.toLowerCase().includes(searchVal) || 
                                    pin.author.toLowerCase().includes(searchVal) ||
                                    pin.locationName.toLowerCase().includes(searchVal);
                const matchStatus = filterStatus === 'ALL' || pin.status === filterStatus;
                const matchSeverity = filterSeverity === 'ALL' || pin.severity === filterSeverity;

                return matchSearch && matchStatus && matchSeverity;
            });

            tbody.innerHTML = '';

            if (filteredPins.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filteredPins.forEach(pin => {
                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-50 transition border-b border-slate-100 cursor-pointer ${
                    activeSelectedPinId === pin.id ? 'bg-indigo-50/60' : ''
                }`;

                // Severity Badge UI
                let sevBadge = '';
                if (pin.severity === 'ต่ำ') sevBadge = '<span class="px-2 py-0.5 rounded-full text-[11px] bg-emerald-100 text-emerald-700 font-medium">ต่ำ</span>';
                else if (pin.severity === 'ปานกลาง') sevBadge = '<span class="px-2 py-0.5 rounded-full text-[11px] bg-amber-100 text-amber-700 font-medium">ปานกลาง</span>';
                else if (pin.severity === 'สูง') sevBadge = '<span class="px-2 py-0.5 rounded-full text-[11px] bg-orange-100 text-orange-700 font-medium">สูง</span>';
                else sevBadge = '<span class="px-2 py-0.5 rounded-full text-[11px] bg-rose-100 text-rose-700 font-bold">วิกฤต</span>';

                // Status Badge UI
                let statusBadge = '';
                if (pin.status === 'รอแก้ไข') statusBadge = '<span class="px-2 py-1 rounded-lg text-xs bg-amber-50 text-amber-600 border border-amber-200 font-medium">รอแก้ไข</span>';
                else if (pin.status === 'กำลังดำเนินการ') statusBadge = '<span class="px-2 py-1 rounded-lg text-xs bg-blue-50 text-blue-600 border border-blue-200 font-medium">กำลังดำเนินการ</span>';
                else statusBadge = '<span class="px-2 py-1 rounded-lg text-xs bg-emerald-50 text-emerald-600 border border-emerald-200 font-medium">แก้ไขแล้ว</span>';

                tr.innerHTML = `
                    <td class="p-3.5 text-center">
                        <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center mx-auto">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                        </div>
                    </td>
                    <td class="p-3.5" onclick="highlightPin('${pin.id}')">
                        <div class="font-semibold text-slate-800">${pin.title}</div>
                        <div class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                            <i data-lucide="map-pin" class="w-3 h-3 text-slate-400"></i> ${pin.locationName}
                        </div>
                    </td>
                    <td class="p-3.5 text-slate-600">${pin.category}</td>
                    <td class="p-3.5 text-center">${sevBadge}</td>
                    <td class="p-3.5">
                        <div class="text-slate-700 font-medium">${pin.author}</div>
                        <div class="text-[11px] text-slate-400">${pin.timestamp}</div>
                    </td>
                    <td class="p-3.5 text-center">${statusBadge}</td>
                    <td class="p-3.5 text-right space-x-1">
                        <select onchange="updatePinStatus('${pin.id}', this.value)" class="text-xs bg-white border border-slate-300 rounded px-1.5 py-1 focus:outline-none">
                            <option value="รอแก้ไข" ${pin.status === 'รอแก้ไข' ? 'selected' : ''}>รอแก้ไข</option>
                            <option value="กำลังดำเนินการ" ${pin.status === 'กำลังดำเนินการ' ? 'selected' : ''}>กำลังดำเนินการ</option>
                            <option value="แก้ไขแล้ว" ${pin.status === 'แก้ไขแล้ว' ? 'selected' : ''}>แก้ไขแล้ว</option>
                        </select>
                        <button onclick="deletePin('${pin.id}')" class="text-slate-400 hover:text-rose-600 p-1" title="ลบรายการ">
                            <i data-lucide="trash-2" class="w-4 h-4 inline"></i>
                        </button>
                    </td>
                `;

                tbody.appendChild(tr);
            });

            lucide.createIcons();
        }

        // Highlight Pin on Plan Canvas
        function highlightPin(pinId) {
            activeSelectedPinId = pinId;
            renderPins();
            renderTable();

            const pin = pins.find(p => p.id === pinId);
            if (pin) {
                // Adjust Zoom Pan transform to focus pin
                zoomScale = 1.2;
                panX = 150 - (pin.x * zoomScale);
                panY = 150 - (pin.y * zoomScale);
                applyTransform();
            }
        }

        // Update Pin Status
        function updatePinStatus(pinId, newStatus) {
            const pin = pins.find(p => p.id === pinId);
            if (pin) {
                pin.status = newStatus;
                saveData();
                renderPins();
                renderTable();
                showToast(`อัปเดตสถานะเป็น "${newStatus}" เรียบร้อย`);
            }
        }

        // Delete Pin
        function deletePin(pinId) {
            if (confirm('คุณต้องการลบรายการจุดเสี่ยงนี้ใช่หรือไม่?')) {
                pins = pins.filter(p => p.id !== pinId);
                saveData();
                renderPins();
                renderTable();
                showToast('ลบรายการจุดเสี่ยงเรียบร้อยแล้ว');
            }
        }

        // Update Summary Stats
        function updateStats() {
            document.getElementById('stat-total').textContent = pins.length;
            document.getElementById('stat-pending').textContent = pins.filter(p => p.status === 'รอแก้ไข').length;
            document.getElementById('stat-progress').textContent = pins.filter(p => p.status === 'กำลังดำเนินการ').length;
            document.getElementById('stat-resolved').textContent = pins.filter(p => p.status === 'แก้ไขแล้ว').length;
        }

        // ADMIN: Upload Custom Floor Plan Image
        function handleImageUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                customPlanImage = evt.target.result;
                localStorage.setItem('laundry_custom_plan_img', customPlanImage);
                renderFloorPlanBackground();
                showToast('อัปโหลดรูปภาพผังอาคารใหม่เรียบร้อยแล้ว');
            };
            reader.readAsDataURL(file);
        }

        // ADMIN: Reset to Default Laundry Plan
        function resetDefaultPlan() {
            if (confirm('คุณต้องการรีเซ็ตผังอาคารกลับเป็นผังเริ่มต้น (งานบริการผ้า ชั้น 1) หรือไม่?')) {
                customPlanImage = null;
                localStorage.removeItem('laundry_custom_plan_img');
                renderFloorPlanBackground();
                showToast('รีเซ็ตผังอาคารเรียนเรียบร้อย');
            }
        }

        // ZOOM & PAN CONTROLS
        function applyTransform() {
            const wrapper = document.getElementById('canvas-transform-wrapper');
            wrapper.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale})`;
        }

        function zoomCanvas(delta) {
            zoomScale = Math.min(Math.max(0.6, zoomScale + delta), 2.5);
            applyTransform();
        }

        function resetZoom() {
            zoomScale = 1;
            panX = 0;
            panY = 0;
            applyTransform();
        }

        function togglePanMode() {
            isPanMode = !isPanMode;
            const btn = document.getElementById('btn-toggle-pan');
            const viewport = document.getElementById('floor-canvas-viewport');

            if (isPanMode) {
                btn.className = "p-1.5 bg-indigo-100 text-indigo-700 rounded text-xs flex items-center gap-1 font-bold";
                viewport.style.cursor = "grab";
                showToast('เข้าสู่โหมดลากผัง (Pan Mode)');
            } else {
                btn.className = "p-1.5 hover:bg-slate-100 rounded text-xs flex items-center gap-1 text-slate-600";
                viewport.style.cursor = "crosshair";
            }
        }

        function setupPanZoomEvents() {
            const viewport = document.getElementById('floor-canvas-viewport');

            viewport.addEventListener('mousedown', (e) => {
                if (!isPanMode) return;
                isDraggingPan = true;
                startPanX = e.clientX - panX;
                startPanY = e.clientY - panY;
                viewport.style.cursor = "grabbing";
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDraggingPan) return;
                panX = e.clientX - startPanX;
                panY = e.clientY - startPanY;
                applyTransform();
            });

            window.addEventListener('mouseup', () => {
                if (isDraggingPan) {
                    isDraggingPan = false;
                    viewport.style.cursor = isPanMode ? "grab" : "crosshair";
                }
            });
        }

        // Modal Helpers
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Toast Messages
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>