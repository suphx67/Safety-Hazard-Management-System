<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบรับแจ้งและบริหารจัดการความปลอดภัยผังอาคาร</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (Kanit & Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Kanit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
        }
        /* Canvas grid background */
        .floor-grid {
            background-size: 24px 24px;
            background-image: 
                linear-gradient(to right, rgba(226, 232, 240, 0.5) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(226, 232, 240, 0.5) 1px, transparent 1px);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        /* Pulse Animation for Critical Pins */
        @keyframes pin-pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pin-pulse {
            animation: pin-pulse 1.2s infinite ease-in-out;
        }
        .plan-transform {
            transform-origin: 0 0;
            transition: transform 0.1s ease-out;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Header Navigation Bar -->
    <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-rose-500 rounded-lg text-white">
                    <i data-lucide="shield-alert" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Safety & Hazard Management System</h1>
                    <p class="text-xs text-slate-400">ระบบรับแจ้งและบริหารจัดการความปลอดภัยด้วยผังอาคารจริง</p>
                </div>
            </div>

            <!-- Mode Selector Switcher -->
            <div class="flex items-center gap-3">
                <div class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700">
                    <button id="btn-mode-user" onclick="switchMode('user')" 
                        class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 bg-emerald-500 text-white shadow-sm">
                        <i data-lucide="user" class="w-4 h-4"></i>
                        <span>โหมดแจ้งเหตุ (User)</span>
                    </button>
                    <button id="btn-mode-admin" onclick="switchMode('admin')" 
                        class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 text-slate-400 hover:text-white">
                        <i data-lucide="settings" class="w-4 h-4"></i>
                        <span>จัดการผัง (Admin)</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

        <!-- Stat Cards / Dashboard Summary -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">จุดเสี่ยงทั้งหมด</p>
                    <h3 id="stat-total" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                </div>
                <div class="p-3 bg-slate-100 rounded-xl text-slate-600">
                    <i data-lucide="map-pin" class="w-6 h-6"></i>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">รอการแก้ไข</p>
                    <h3 id="stat-pending" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                </div>
                <div class="p-3 bg-amber-50 rounded-xl text-amber-600">
                    <i data-lucide="clock" class="w-6 h-6"></i>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">กำลังดำเนินการ</p>
                    <h3 id="stat-progress" class="text-2xl font-bold text-blue-600 mt-1">0</h3>
                </div>
                <div class="p-3 bg-blue-50 rounded-xl text-blue-600">
                    <i data-lucide="wrench" class="w-6 h-6"></i>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">แก้ไขเสร็จสิ้น</p>
                    <h3 id="stat-resolved" class="text-2xl font-bold text-emerald-600 mt-1">0</h3>
                </div>
                <div class="p-3 bg-emerald-50 rounded-xl text-emerald-600">
                    <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                </div>
            </div>
        </section>

        <!-- Floor Plan Layout Container -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- Floor Plan Top Bar -->
            <div class="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3 bg-slate-50/50">
                <div class="flex items-center space-x-2">
                    <i data-lucide="layout-grid" class="w-5 h-5 text-slate-500"></i>
                    <h2 class="font-semibold text-slate-800" id="plan-title">ผังอาคาร: งานบริการผ้า ชั้น 1</h2>
                    <span id="mode-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                        โหมดผู้ใช้: คลิกปักหมุดเพื่อแจ้งเหตุ
                    </span>
                </div>

                <!-- Floor Controls & Admin Tools -->
                <div class="flex items-center flex-wrap gap-2">
                    <!-- Zoom & Pan Controls -->
                    <div class="flex items-center bg-white border border-slate-200 rounded-lg shadow-sm p-0.5 text-slate-600">
                        <button onclick="zoomCanvas(0.15)" title="ซูมเข้า" class="p-1.5 hover:bg-slate-100 rounded text-xs">
                            <i data-lucide="zoom-in" class="w-4 h-4"></i>
                        </button>
                        <button onclick="zoomCanvas(-0.15)" title="ซูมออก" class="p-1.5 hover:bg-slate-100 rounded text-xs">
                            <i data-lucide="zoom-out" class="w-4 h-4"></i>
                        </button>
                        <button onclick="resetZoom()" title="รีเซ็ตมุมมอง" class="p-1.5 hover:bg-slate-100 rounded text-xs">
                            <i data-lucide="maximize-2" class="w-4 h-4"></i>
                        </button>
                        <div class="h-4 w-px bg-slate-200 mx-1"></div>
                        <button id="btn-toggle-pan" onclick="togglePanMode()" title="โหมดลากผังอาคาร (Pan Mode)" class="p-1.5 hover:bg-slate-100 rounded text-xs flex items-center gap-1">
                            <i data-lucide="hand" class="w-4 h-4"></i>
                            <span class="text-[11px] font-medium hidden sm:inline">ลากผัง</span>
                        </button>
                    </div>

                    <!-- Admin Upload Floor Plan Controls -->
                    <div id="admin-controls" class="hidden flex items-center gap-2">
                        <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-2 rounded-lg font-medium transition shadow-sm flex items-center space-x-1">
                            <i data-lucide="upload" class="w-4 h-4"></i>
                            <span>อัปโหลดภาพผังใหม่</span>
                            <input type="file" id="upload-plan-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                        </label>
                        <button onclick="resetDefaultPlan()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition flex items-center space-x-1">
                            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                            <span>ใช้ผังเริ่มต้น</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Floor Plan Interactive Canvas Area -->
            <div class="p-4 relative">
                <!-- Instruction Hint -->
                <div id="instruction-bar" class="mb-3 p-2.5 bg-blue-50 border border-blue-100 rounded-xl text-xs text-blue-700 flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i>
                        <span id="instruction-text">คลิกตรงตำแหน่งบนผังอาคารจริง เพื่อปักหมุดแจ้งจุดเสี่ยง/อันตราย</span>
                    </div>
                    <div class="flex items-center gap-3 text-slate-500 text-xs font-medium">
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> ต่ำ</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> ปานกลาง</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span> สูง</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-rose-600"></span> วิกฤต</span>
                    </div>
                </div>

                <!-- Main Viewport Canvas Container -->
                <div id="floor-canvas-viewport" class="relative w-full h-[520px] sm:h-[620px] bg-slate-200 rounded-xl border-2 border-slate-300 overflow-hidden floor-grid cursor-crosshair">
                    
                    <!-- Zoom & Pan Layer Container -->
                    <div id="canvas-transform-wrapper" class="absolute inset-0 plan-transform">
                        
                        <!-- SVG / Image Background Floor Plan Layer -->
                        <div id="floor-plan-background" class="relative w-[1000px] h-[680px] bg-white shadow-md mx-auto my-auto select-none overflow-hidden" onclick="handleCanvasClick(event)">
                            
                            <!-- Dynamic Render Background (Uploaded Image or Default SVG Canvas) -->
                            <div id="plan-graphics-container" class="absolute inset-0 w-full h-full"></div>

                            <!-- Pins Layer Overlay -->
                            <div id="pins-container" class="absolute inset-0 pointer-events-none"></div>

                        </div>

                    </div>

                    <!-- Map Legend Overlay (Bottom Left) -->
                    <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md p-3 rounded-xl shadow-lg border border-slate-200 text-[11px] text-slate-700 space-y-1 z-20 pointer-events-none hidden sm:block">
                        <div class="font-bold text-slate-800 border-b pb-1 mb-1">สัญลักษณ์โซนงานบริการผ้า</div>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-1">
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-sky-100 border border-sky-300"></span> ห้องพับผ้า</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-purple-100 border border-purple-300"></span> ห้องบรรจุผ้า</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-fuchsia-100 border border-fuchsia-300"></span> ห้องเครื่องซักผ้า</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-100 border border-emerald-300"></span> ห้องเครื่องอบผ้า</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-rose-100 border border-rose-300"></span> ห้องชั่งน้ำหนักผ้า</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-100 border border-amber-300"></span> ห้องควบคุม</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-cyan-100 border border-cyan-300"></span> ห้องเก็บสารเคมี</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-slate-300 border border-slate-400"></span> บริเวณเครื่องรีดผ้า</span>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Reports Table & Management Section -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-4 sm:p-5 border-b border-slate-100 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 class="font-semibold text-lg text-slate-800">ตารางบันทึกรายละเอียดการรับแจ้งและตำแหน่งจุดเสี่ยง</h2>
                        <p class="text-xs text-slate-500">คลิกรายการในตารางเพื่อไฮไลท์หมุดบนผังอาคาร หรือกรอกข้อมูลค้นหา</p>
                    </div>
                    
                    <!-- Filter & Search Bar -->
                    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                        <div class="relative flex-1 sm:w-48">
                            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
                            <input type="text" id="search-input" oninput="renderTable()" placeholder="ค้นหาหัวข้อ / ผู้แจ้ง / โซน..." 
                                class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                        </div>
                        
                        <select id="filter-status" onchange="renderTable()" class="py-1.5 px-3 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="ALL">สถานะทั้งหมด</option>
                            <option value="รอแก้ไข">รอแก้ไข</option>
                            <option value="กำลังดำเนินการ">กำลังดำเนินการ</option>
                            <option value="แก้ไขแล้ว">แก้ไขแล้ว</option>
                        </select>

                        <select id="filter-severity" onchange="renderTable()" class="py-1.5 px-3 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="ALL">ความรุนแรงทั้งหมด</option>
                            <option value="วิกฤต">วิกฤต</option>
                            <option value="สูง">สูง</option>
                            <option value="ปานกลาง">ปานกลาง</option>
                            <option value="ต่ำ">ต่ำ</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-medium border-b border-slate-200">
                            <th class="p-3.5 text-center w-12">ไอคอน</th>
                            <th class="p-3.5">หัวข้อจุดเสี่ยง / โซนผังอาคาร</th>
                            <th class="p-3.5">ประเภทความเสี่ยง</th>
                            <th class="p-3.5 text-center">ระดับความรุนแรง</th>
                            <th class="p-3.5">ผู้แจ้ง / เวลา</th>
                            <th class="p-3.5 text-center">สถานะ</th>
                            <th class="p-3.5 text-right">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-slate-100 text-xs sm:text-sm">
                        <!-- Dynamic Rows Rendered Here -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="empty-state" class="hidden p-8 text-center text-slate-400">
                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 stroke-1"></i>
                <p>ไม่พบรายการแจ้งเหตุที่ตรงกับเงื่อนไข</p>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            © 2026 ระบบบริหารจัดการความปลอดภัยด้วยผังอาคารจริง (Laundry & School Building Safety System)
        </div>
    </footer>

    <!-- MODAL: Add/Edit Hazard Report Modal (User) -->
    <div id="report-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform transition-all scale-100 space-y-4">
            <div class="flex items-center justify-between border-b pb-3">
                <div class="flex items-center space-x-2 text-rose-600">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                    <h3 class="font-bold text-slate-800 text-base">แบบฟอร์มระบุรายละเอียดจุดเสี่ยง/อันตราย</h3>
                </div>
                <button onclick="closeModal('report-modal')" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form id="hazard-form" onsubmit="handleFormSubmit(event)" class="space-y-3.5">
                <!-- Hidden Coordinates -->
                <input type="hidden" id="report-x">
                <input type="hidden" id="report-y">

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">หัวข้อจุดเสี่ยง/อันตรายที่พบ <span class="text-rose-500">*</span></label>
                    <input type="text" id="report-title" required placeholder="เช่น ท่อไอน้ำรั่ว, ปลั๊กไฟตู้ซักผ้าชำรุด, สารเคมีหก" 
                        class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ประเภทความเสี่ยง</label>
                        <select id="report-category" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:outline-none">
                            <option value="เครื่องจักร/อุปกรณ์">⚙️ เครื่องจักร/อุปกรณ์</option>
                            <option value="ระบบไฟฟ้า/ความร้อน">⚡ ระบบไฟฟ้า/ความร้อน</option>
                            <option value="สารเคมี/ความปลอดภัย">🧪 สารเคมี/ความปลอดภัย</option>
                            <option value="พื้นลื่น/ทางเดิน">🪵 พื้นลื่น/ทางเดิน</option>
                            <option value="โครงสร้าง/อาคาร">🏗️ โครงสร้าง/อาคาร</option>
                            <option value="อื่นๆ">⚠️ อื่นๆ</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ระดับความรุนแรง</label>
                        <select id="report-severity" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:outline-none">
                            <option value="ต่ำ">🟢 ต่ำ (เฝ้าระวัง)</option>
                            <option value="ปานกลาง" selected>🟡 ปานกลาง (ควรแก้ไข)</option>
                            <option value="สูง">🟠 สูง (อันตราย)</option>
                            <option value="วิกฤต">🔴 วิกฤต (ด่วนที่สุด)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">รายละเอียดเพิ่มเติม</label>
                    <textarea id="report-desc" rows="3" placeholder="ระบุรายละเอียดเพิ่มเติม สภาพปัญหา หรือข้อสังเกต..." 
                        class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ผู้แจ้งเหตุ <span class="text-rose-500">*</span></label>
                        <input type="text" id="report-author" required placeholder="ชื่อผู้แจ้ง / เจ้าหน้าที่" 
